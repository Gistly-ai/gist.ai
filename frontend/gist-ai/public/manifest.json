{
  "manifest_version": 3,
  "name": "Gist Ai",
  "version": "1.0",
  "description": "A Chrome extension to keep a reading list.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation" ],
    "host_permissions": ["https://*/*"] ,
    "background": {
      "service_worker": "background.js"
    },
     "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
   }
   